# SPDX-License-Identifier: Apache-2.0
#
# The action's RED lane. CI requires this file to fail, and it has to fail
# for the reason it exists: `use_ghost` reads a task that is not in the DAG.
# A fixture that fails for the wrong reason (PARSE on a dead envelope, not
# the ghost) is a test that cannot fail for the right one.
#
# If you modernise this file, keep the ghost. That is the whole point.

# the red lane · a reference to a task that does not exist
nika: broken-probe

model: ollama/qwen3.5:4b

permits:
  tools: ["nika:read"]
  fs:    { read: ["./in.txt"] }
  exec:  false

tasks:
  gather:
    invoke:
      tool: "nika:read"
      args: { path: "./in.txt" }

  use_ghost:
    with:
      facts: ${{ tasks.ghost.output }}   # ← THE defect · `ghost` is not a task
    infer:
      prompt: "Summarize ${{ with.facts }}"
