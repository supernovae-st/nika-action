# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
#
# The action's own clean-lane fixture · gather facts → one model step.
# Effect-free BY DESIGN: the golden lane runs `nika test` (the mock plane
# simulates the model, not effects — a `nika:write` there is refused,
# NIKA-452), so the fixture ends at the typed output. The full
# gather→think→persist shape lives in the engine's `chain` skeleton
# (`nika new chain <file>`).
#
# CI runs the action on this file and requires exit 0. It therefore has
# to be current, not merely plausible — a fixture that fails the check it
# demonstrates teaches the wrong thing twice.
#
# Instantiate (agents · deterministic) ·
#   1. Copy this file · rename per the job (kebab-case).
#   2. Fill every `# SLOT:` line · delete slot comments when filled.
#   3. Validate · `nika check <file>`.
#   4. Repair using the error's fix line · re-check until exit 0.
#
# Rules the checker enforces · one verb per task · snake_case ids · a task
# that reads another's output BINDS it in `with:` (the binding IS the edge:
# `depends_on:` died in W2) · fixed values live in `const:`, typed
# parameters in `inputs:` (`vars:` is dead · NIKA-VALUES-001).

# gather → think
nika: chain-template                  # SLOT: kebab-case workflow id

model: ollama/qwen3.5:4b              # SLOT: provider/model · local · zero key

const:
  source: "fixtures/input.txt"        # SLOT: a fixed value · a typed parameter goes in inputs:

# The blast radius, declared in the file: one tool, one read path, no
# shells. Everything else is refused before it runs.
permits:
  tools: ["nika:read"]
  fs:    { read: ["fixtures/**"] }
  exec:  false

tasks:
  gather:
    invoke:                           # SLOT: the fact source · nika:read / nika:fetch
      tool: "nika:read"
      args: { path: "${{ const.source }}" }

  think:
    with:
      facts: ${{ tasks.gather.output }}    # the binding IS the edge
    infer:
      prompt: |
        # SLOT: the one model job
        Summarize · ${{ with.facts }}


outputs:
  result: ${{ tasks.think.output }}  # SLOT: the callable contract
